# Para rodar a API ou os testes direto na máquina, fora do compose.
# Copie para .env (que é gitignored).
#
# Aponta para o Postgres do compose, exposto na 5432 — suba com `make up`
# antes. Os valores precisam bater com o .env da raiz do repositório.

DB_HOST=localhost
DB_PORT=5432
DB_USER=ecommerce
DB_PASSWORD=dev-only-nao-use-em-producao
DB_NAME=ecommerce

CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=dev
