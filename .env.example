# Copie para .env e ajuste. As credenciais do banco não têm default no código:
# a API falha no boot se DB_USER, DB_PASSWORD ou DB_NAME estiverem ausentes ou
# vazios.
#
# DB_HOST=postgres é o nome do serviço no compose. Para rodar a API fora dele,
# use apps/api/.env (ver apps/api/.env.dev.example).

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=ecommerce
DB_PASSWORD=troque-esta-senha
DB_NAME=ecommerce

# --- API ---
# Origens permitidas no CORS, separadas por vírgula. Vazio = nenhuma.
# No fluxo padrão o SPA chama /api na mesma origem (proxy do Vite), então o
# CORS não entra em jogo. Isto existe para rodar o front fora do compose,
# apontando para uma API remota.
CORS_ORIGINS=

# Prefixo público das imagens de produto. Aponte para um CDN se quiser.
MEDIA_BASE_URL=/static/products

# Frete fixo, em reais.
SHIPPING_FEE=10.00

# ENVIRONMENT não aparece aqui de propósito: o docker-compose.yml fixa `dev`
# para o serviço da API, então qualquer valor neste arquivo seria ignorado.
